<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="540.0" prefWidth="950.0" spacing="18.0" style="-fx-background-color: #ADADAD;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E293B;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="backButton" mnemonicParsing="false" text="&lt; Back" />
                <Label text="ACCOUNT DETAILS &amp; TRANSACTIONS" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" mnemonicParsing="false" text="Logout" />
            </children>
        </HBox>

        <VBox spacing="8.0" style="-fx-background-color: #FFFFFF;">
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
            </padding>
            <children>
                <Label fx:id="accountHeaderLabel" text="2001458932 - Cheque Account">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <Label fx:id="balanceLabel" text="BWP 0.00">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF;">
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <TextField fx:id="amountField" prefHeight="36.0" prefWidth="250.0" promptText="Amount (BWP)" />
                <Button fx:id="depositButton" mnemonicParsing="false" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #1D4ED8;" text="DEPOSIT" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="withdrawButton" mnemonicParsing="false" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #16A34A;" text="WITHDRAW" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="interestButton" mnemonicParsing="false" prefHeight="36.0" prefWidth="160.0" style="-fx-background-color: #1E293B;" text="APPLY INTEREST" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <VBox spacing="10.0" style="-fx-background-color: #FFFFFF;">
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label text="TRANSACTION HISTORY">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <ListView fx:id="transactionsListView" prefHeight="150.0" />
            </children>
        </VBox>

        <Label fx:id="messageLabel">
            <VBox.margin>
                <Insets left="30.0" />
            </VBox.margin>
        </Label>
    </children>
</VBox>
