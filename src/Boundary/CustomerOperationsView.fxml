<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="950.0" spacing="40.0" style="-fx-background-color: #ADADAD;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E293B;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label text="CUSTOMER OPERATIONS" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" mnemonicParsing="false" text="Logout" />
            </children>
        </HBox>
        <Label text="SELECT AN ACTION">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" spacing="35.0">
            <children>
                <VBox alignment="CENTER" prefHeight="220.0" prefWidth="280.0" spacing="15.0" style="-fx-background-color: #FFFFFF;">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <Button fx:id="createCustomerButton" mnemonicParsing="false" prefHeight="55.0" prefWidth="220.0" style="-fx-background-color: #1D4ED8;" text="CREATE NEW CUSTOMER" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Label text="Register Individual or Company" textFill="#475569" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" prefHeight="220.0" prefWidth="280.0" spacing="15.0" style="-fx-background-color: #FFFFFF;">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <Button fx:id="searchCustomerButton" mnemonicParsing="false" prefHeight="55.0" prefWidth="220.0" style="-fx-background-color: #1E293B;" text="SEARCH BY OMANG ID" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Label text="Add, Close, or Manage Accounts" textFill="#475569" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
