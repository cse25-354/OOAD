<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: #ADADAD;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E293B;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="backButton" mnemonicParsing="false" text="Back" />
                <Label text="REGISTER NEW CUSTOMER" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" mnemonicParsing="false" text="Logout" />
            </children>
        </HBox>
        <VBox spacing="12.0" style="-fx-background-color: #FFFFFF;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <children>
                <Label text="CUSTOMER DETAILS">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <HBox spacing="12.0">
                    <children>
                        <ComboBox fx:id="customerTypeCombo" prefWidth="150.0" />
                        <TextField fx:id="firstNameField" promptText="First Name" />
                        <TextField fx:id="surnameField" promptText="Surname" />
                        <TextField fx:id="omangField" promptText="Omang ID (9 digits)" />
                        <TextField fx:id="genderField" promptText="Gender M/F" />
                        <TextField fx:id="addressField" promptText="Address/Phone" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <VBox spacing="12.0" style="-fx-background-color: #FFFFFF;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <children>
                <Label text="EMPLOYER DETAILS (Required for Cheque Accounts)">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <HBox spacing="15.0">
                    <children>
                        <TextField fx:id="employerNameField" prefWidth="420.0" promptText="Employer Name" />
                        <TextField fx:id="employerAddressField" prefWidth="420.0" promptText="Employer Physical Address" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <children>
                <Button fx:id="saveButton" mnemonicParsing="false" style="-fx-background-color: #16A34A;" text="SAVE &amp; CONTINUE" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        <Label fx:id="messageLabel">
            <VBox.margin>
                <Insets left="30.0" />
            </VBox.margin>
        </Label>
    </children>
</VBox>
