<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="520.0" prefWidth="950.0" spacing="18.0" style="-fx-background-color: #ADADAD;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E293B;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="backButton" mnemonicParsing="false" text="&lt; Back" />
                <Label text="ACCOUNTS OVERVIEW" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" mnemonicParsing="false" text="Logout" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF;">
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <TextField fx:id="searchOmangField" prefWidth="350.0" promptText="Search by Omang ID (9 digits) or Reg No." />
                <Button fx:id="searchButton" mnemonicParsing="false" style="-fx-background-color: #1D4ED8;" text="SEARCH" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="customerProfileLabel" text="No customer selected">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <VBox spacing="12.0" style="-fx-background-color: #FFFFFF;">
            <VBox.margin>
                <Insets left="30.0" right="30.0" />
            </VBox.margin>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="OWNED ACCOUNTS">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ListView fx:id="accountsListView" prefHeight="210.0" />
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="openNewAccountButton" mnemonicParsing="false" prefHeight="38.0" style="-fx-background-color: #16A34A;" text="+ OPEN NEW ACCOUNT" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="manageAccountButton" mnemonicParsing="false" prefHeight="38.0" style="-fx-background-color: #1D4ED8;" text="MANAGE SELECTED ACCOUNT" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="closeAccountButton" mnemonicParsing="false" prefHeight="38.0" style="-fx-background-color: #DC2626;" text="- CLOSE ACCOUNT" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label fx:id="messageLabel">
            <VBox.margin>
                <Insets left="30.0" />
            </VBox.margin>
        </Label>
    </children>
</VBox>
